# Старые демонстрационные разделы преподавателя/администратора.
VITE_USE_MOCKS=true

# API только для Обзора, результатов обучающегося и АРМ.
# false возвращает предыдущие локальные занятия и карточки.
VITE_STUDENT_API_ENABLED=true

# Необязательно: UUID существующего обучающегося с назначениями.
# Без значения UUID можно ввести на странице «Обзор».
# Это временная идентификация X-User-Id, не реализованная авторизация.
VITE_STUDENT_ID=

# По умолчанию /student-api; Vite проксирует туда, куда указывает
# VITE_CARD_API_PROXY_TARGET. Для production настройте такой же reverse proxy
# либо задайте доступный адрес API (понадобятся CORS и HTTPS при HTTPS-фронтенде).
VITE_ARM_API_URL=/student-api

# Базовый адрес сервиса авторизации. По умолчанию /auth-api, который Vite
# проксирует туда, куда указывает VITE_AUTH_API_PROXY_TARGET.
VITE_AUTH_API_URL=/auth-api

# Адреса стенда для dev-прокси. Значения пустые: адрес бэкенда в репозитории
# не хранится и задаётся локально в frontend/.env. Пока переменная пуста,
# Vite не регистрирует соответствующий прокси и запросы к бэкенду не уходят.
# Для локального compose это http://127.0.0.1:8080 и http://127.0.0.1:8084.
VITE_CARD_API_PROXY_TARGET=
VITE_AUTH_API_PROXY_TARGET=
