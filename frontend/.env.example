# Старые демонстрационные разделы преподавателя/администратора.
VITE_USE_MOCKS=true

# API только для Обзора, результатов обучающегося и АРМ.
# false возвращает предыдущие локальные занятия и карточки.
VITE_STUDENT_API_ENABLED=true

# По умолчанию /student-api; Vite проксирует туда, куда указывает
# VITE_CARD_API_PROXY_TARGET. Для production настройте такой же reverse proxy
# либо задайте доступный адрес API (понадобятся CORS и HTTPS при HTTPS-фронтенде).
VITE_ARM_API_URL=/student-api
VITE_REALTIME_GATEWAY_URL=/realtime-gateway

# Базовый адрес сервиса авторизации. По умолчанию /auth-api, который Vite
# проксирует туда, куда указывает VITE_AUTH_API_PROXY_TARGET.
VITE_AUTH_API_URL=/auth-api

# Адреса стенда для dev-прокси. Значения пустые: адрес бэкенда в репозитории
# не хранится и задаётся локально в frontend/.env. Пока переменная пуста,
# Vite не регистрирует соответствующий прокси и запросы к бэкенду не уходят.
# Для локального compose это http://127.0.0.1:8080 и http://127.0.0.1:8084.
VITE_CARD_API_PROXY_TARGET=
VITE_AUTH_API_PROXY_TARGET=
# По умолчанию Vite подключается к локальному realtime gateway на порту 8081.
VITE_REALTIME_GATEWAY_PROXY_TARGET=

# Моки ручек, которые на бэкенде есть. По умолчанию выключены: без значения и с любым
# значением, кроме строки true, запрос идёт на бэкенд. Мок включается только явной строкой
# true — когда стенд недоступен или на нём нет завершённой попытки со звонком.
# Покрывают: расшифровку звонка, журнал действий, контекст разбора, группы, список
# обучающихся и их историю попыток, справочник служб, сессии монитора преподавателя,
# сценарии, назначения сценариев.
# У записи звонка мока нет: подставной звук не делается, без стенда экран показывает,
# что запись недоступна.
VITE_MOCK_CALL_TRANSCRIPT=false
VITE_MOCK_CARD_TIMELINE=false
VITE_MOCK_EXPERT_REVIEW=false
VITE_MOCK_GROUPS=false
VITE_MOCK_STUDENTS=false
VITE_MOCK_SERVICES=false
VITE_MOCK_MONITORING=false
VITE_MOCK_SCENARIOS=false
VITE_MOCK_ASSIGNMENTS=false
