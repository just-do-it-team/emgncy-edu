POSTGRES_DB=s112
POSTGRES_USER=s112
POSTGRES_PASSWORD=change-me
POSTGRES_REPLICATION_USER=replicator
POSTGRES_REPLICATION_PASSWORD=change-replication-password

# По умолчанию все порты доступны только локально на сервере.
# Для API задайте APP_BIND_ADDRESS=0.0.0.0 только при наличии firewall,
# TLS/reverse proxy и аутентификации. Инфраструктурные порты наружу не публикуйте.
INFRA_BIND_ADDRESS=127.0.0.1
APP_BIND_ADDRESS=127.0.0.1
ADMIN_BIND_ADDRESS=127.0.0.1

# Адрес, который Kafka сообщает внешним клиентам. При локальном bind оставьте localhost.
KAFKA_ADVERTISED_HOST=localhost

# Порты, публикуемые на хосте
POSTGRES_PRIMARY_PORT=5432
POSTGRES_REPLICA_PORT=5433
KAFKA_1_PORT=29092
KAFKA_2_PORT=39092
KAFKA_3_PORT=49092
SEAWEED_FILER_1_PORT=8888
SEAWEED_FILER_2_PORT=8889
CARD_API_PORT=8080
REALTIME_GATEWAY_PORT=8081
ADMIN_API_PORT=8082
AUTH_API_PORT=8084
SPEECH_API_PORT=8083
PROMETHEUS_PORT=9090
GRAFANA_PORT=3000

# Доступ к Grafana. Перед публикацией стенда пароль требуется заменить.
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change-me
GRAFANA_PUBLIC_URL=http://localhost:3000

# Настройки admin-api
ADMIN_REQUEST_TIMEOUT_SECONDS=5
ADMIN_MAX_LOG_EXPORT_ROWS=5000

# Локальная авторизация. Сгенерируйте уникальную случайную строку не короче
# 32 символов. AUTH_ENABLED=false оставляет card-api и admin-api открытыми.
AUTH_ENABLED=false
AUTH_JWT_SECRET=replace-with-a-random-secret-at-least-32-characters
AUTH_JWT_ISSUER=s112-auth
AUTH_JWT_AUDIENCE=s112-api
AUTH_ACCESS_TOKEN_TTL_SECONDS=3600

# Эти URL используются контейнерами приложения и Alembic. Зарезервированные
# символы в логине/пароле должны быть percent-encoded как компоненты URL.
S112_DATABASE_URL=postgresql+asyncpg://s112:change-me@postgres-primary:5432/s112
S112_READ_DATABASE_URL=postgresql+asyncpg://s112:change-me@postgres-replica:5432/s112
S112_KAFKA_BOOTSTRAP_SERVERS=kafka-1:19092,kafka-2:19092,kafka-3:19092
S112_KAFKA_TOPIC=card.events
S112_AUDIO_STT_REQUEST_TOPIC=audio.stt.requested.v1
S112_AUDIO_STT_RESULT_TOPIC=audio.stt.completed.v1
S112_AUDIO_TTS_REQUEST_TOPIC=audio.tts.requested.v1
S112_AUDIO_TTS_RESULT_TOPIC=audio.tts.completed.v1
S112_AUDIO_FAILED_TOPIC=audio.processing.failed.v1
S112_SPEECH_REQUEST_CONSUMER_GROUP=speech-request-worker-v1
S112_SPEECH_RESULT_CONSUMER_GROUP=speech-result-worker-v1
S112_SEMANTIC_EVALUATION_REQUEST_TOPIC=training.semantic-evaluation.requested.v1
S112_SEMANTIC_EVALUATION_RESULT_TOPIC=training.semantic-evaluation.completed.v1
S112_SEMANTIC_REQUEST_CONSUMER_GROUP=semantic-evaluation-request-worker-v1
S112_SEMANTIC_RESULT_CONSUMER_GROUP=semantic-evaluation-result-worker-v1
S112_SEMANTIC_EVALUATION_API_URL=http://host.docker.internal:4555
S112_SEMANTIC_EVALUATION_MODEL=gpt-oss-20b
S112_SEMANTIC_EVALUATION_TIMEOUT_SECONDS=120
S112_SEMANTIC_EVALUATION_RETRY_LIMIT=5
S112_SEMANTIC_EVALUATION_RETRY_BASE_SECONDS=1
S112_SEMANTIC_EVALUATION_MAX_POLL_INTERVAL_SECONDS=1800
S112_SEAWEED_FILER_URLS=http://seaweed-filer-1:8888,http://seaweed-filer-2:8888
S112_SEAWEED_AUDIO_PREFIX=/audio
S112_SEAWEED_TIMEOUT_SECONDS=60
S112_AUDIO_MAX_UPLOAD_BYTES=26214400
S112_TTS_MAX_TEXT_CHARS=8000
S112_SPEECH_API_URL=http://speech-api:8083
S112_SPEECH_API_TIMEOUT_SECONDS=240
S112_SPEECH_WORKER_RETRY_LIMIT=5
S112_SPEECH_WORKER_RETRY_BASE_SECONDS=1
S112_SPEECH_WORKER_MAX_POLL_INTERVAL_SECONDS=1800
S112_AUDIO_RECONCILE_INTERVAL_SECONDS=300
S112_AUDIO_ORPHAN_GRACE_SECONDS=3600
S112_REALTIME_INSTANCE_ID=realtime-1
S112_OUTBOX_POLL_INTERVAL_SECONDS=0.05
S112_CALL_VAD_SILENCE_MS=600
S112_DIALOGUE_LLM_BASE_URL=http://host.docker.internal:4555/v1
S112_DIALOGUE_LLM_MODEL=gpt-oss-20b
S112_DIALOGUE_LLM_API_KEY=
S112_DIALOGUE_LLM_TIMEOUT_SECONDS=120
S112_DIALOGUE_LLM_HISTORY_MESSAGES=12
S112_TEMPLATE_GENERATION_TIMEOUT_SECONDS=600
S112_TEMPLATE_GENERATION_POLL_INTERVAL_SECONDS=1
S112_TEMPLATE_GENERATION_RETRY_LIMIT=3
S112_TEMPLATE_GENERATION_STALE_SECONDS=900
S112_TEMPLATE_GENERATION_MALE_VOICE_ID=112_male.mp3
S112_TEMPLATE_GENERATION_FEMALE_VOICE_ID=female.mp3
S112_DIALOGUE_REQUEST_TOPIC=dialogue.requested.v1
S112_OUTBOX_BATCH_SIZE=100
S112_SCENARIO_WORKER_POLL_INTERVAL_SECONDS=0.5
S112_SCENARIO_WORKER_BATCH_SIZE=100
S112_SCENARIO_WORKER_RETRY_LIMIT=5

# Модели монтируются только в отдельный GPU-сервис speech-api.
SPEECH_MODELS_DIR=./models
TTS_DEFAULT_VOICE_ID=reference.mp3
CUDA_VERSION=13.0.2
# RTX 2060 имеет Compute Capability 7.5. Для другой GPU укажите её архитектуру CMake.
CUDA_ARCHITECTURES=75-real
LLAMA_CPP_REF=master
PYTORCH_INDEX_URL=https://download.pytorch.org/whl/cu130
S112_PRELOAD_MODELS=true
S112_STT_DEVICE=cuda
S112_STT_FP16=true
S112_TTS_LANGUAGE=ru
S112_TTS_TIMEOUT_SECONDS=180
S112_TTS_STARTUP_TIMEOUT_SECONDS=180
S112_TTS_GPU_LAYERS=99
S112_TTS_CONTEXT_SIZE=4096
S112_TTS_BATCH_SIZE=512
S112_TTS_UBATCH_SIZE=512
S112_TTS_MAX_FRAMES=160
S112_TTS_TOP_K=40
S112_TTS_TOP_P=0.9
S112_TTS_TEMPERATURE=0.8
S112_TTS_SEED=-1
